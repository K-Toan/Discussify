@page "{id:int}"
@model RazorClient.Pages.Communities.DetailsModel
@{
}

<div class="pt-5 pb-5"></div>

<div class="container mx-auto p-4 max-w-5xl">
    <!-- Header Section -->
    <div class="bg-blue-700 rounded-lg p-6 text-white mb-4 flex items-center space-x-4">
        <!-- Avatar -->
        <img src="https://www.shutterstock.com/image-vector/group-abstract-diverse-people-friends-600nw-2121864335.jpg" alt="Avatar" class="w-16 h-16 rounded-full object-cover border-2 border-white">

        <!-- Community Information -->
        <div>
            <h1 class="text-3xl font-bold">@Model.Community.Name</h1>
            <p class="text-gray-200">@Model.Community.Description</p>
            <div class="text-sm mt-2">
                <span>Created by <strong>@Model.Community.CreatorName</strong></span> •
                <span>@Model.Community.CreatedAt.ToString("MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Main Content Section -->
    <div class="flex flex-col lg:flex-row gap-6">
        <!-- Left Column (Posts) -->
        <div class="w-full lg:w-3/4">
            <!-- Create Post Form -->
            <div class="bg-dark p-4 rounded-lg shadow mb-4">
                @{
                    var isJoined = false;
                    foreach (var subscription in Model.Subscriptions)
                    {
                        if (subscription.CommunityId == Model.Community.CommunityId)
                        {
                            isJoined = true;
                        }
                    }

                    if (isJoined)
                    {
                        <a type="button" href="/Communities/LeaveCommunity?communityId=@(Model.Community.CommunityId)&redirectUrl=/Communities/Details/@(Model.Community.CommunityId)" class="mt-2 px-4 py-2 bg-red-600 text-white rounded hover:bg-blue-500">Leave</a>
                        <a type="button" asp-page="/Posts/Create" asp-route-communityId="@Model.Community.CommunityId" class="mt-2 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-500">New Post</a>
                    }
                    else
                    {
                        <a type="button" href="/Communities/JoinCommunity?communityId=@(Model.Community.CommunityId)&redirectUrl=/Communities/Details/@(Model.Community.CommunityId)" class="mt-2 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-500">Join</a>
                    }
                }
            </div>

            <!-- List of Posts -->
            <!-- Thêm danh sách các bài viết nếu có -->
            @foreach (var post in Model.Posts)
            {
                <div class="mx-auto w-full max-w-2xl border-t border-gray-200 dark:border-gray-700"></div>
                <div class="flex justify-between px-4 mt-2 mb-2 mx-auto max-w-screen-xl">
                    <article class="mx-auto w-full max-w-2xl mt-2 mb-2 format format-sm sm:format-base lg:format-lg format-blue dark:format-invert">
                        <!-- Header/User information -->
                        <div class="not-format">
                            <address class="flex items-center not-italic">
                                <div class="inline-flex items-center mr-3 text-sm text-gray-900 dark:text-white">
                                    <img class="mr-2 w-8 h-8 rounded" src="https://isobarscience-1bfd8.kxcdn.com/wp-content/uploads/2020/09/default-profile-picture1.jpg" alt="@post.UserName">
                                    <div>
                                        @if (post.CommunityId.HasValue)
                                        {
                                            <a asp-page="Community/" asp-route-id="@post.CommunityId" class="text-sm font-medium text-gray-500 dark:text-gray-400">@("c/" + post.CommunityName)</a>
                                        }
                                        else
                                        {
                                            <a asp-page="User/" asp-route-id="@post.UserId" class="text-sm font-medium text-gray-500 dark:text-gray-400">@("p/" + post.UserName)</a>
                                        }
                                        @{
                                            var vietnamTimeZone = TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");
                                            var createdTimeInVietnam = TimeZoneInfo.ConvertTimeFromUtc(post.CreatedAt, vietnamTimeZone);
                                            var elapsedTime = DateTimeOffset.Now - createdTimeInVietnam;

                                            string timeAgo;

                                            if (elapsedTime.TotalMinutes < 60)
                                            {
                                                timeAgo = $"{Math.Floor(elapsedTime.TotalMinutes)} minute(s) ago";
                                            }
                                            else if (elapsedTime.TotalHours < 24)
                                            {
                                                timeAgo = $"{Math.Floor(elapsedTime.TotalHours)} hr. ago";
                                            }
                                            else
                                            {
                                                timeAgo = $"{Math.Floor(elapsedTime.TotalDays)} day(s) ago";
                                            }
                                        }
                                        <span class="text-base text-gray-500 dark:text-gray-400"> • @timeAgo</span>
                                    </div>
                                </div>
                            </address>
                            <a href="/Posts/Details/@post.PostId" class="text-xl font-light leading-tight text-gray-900 lg:mb-1 lg:text-xl dark:text-white">@post.Title</a>

                            <!-- Body content -->
                            <p class="body mb-1">
                                @post.Content
                            </p>

                            <!-- Interaction bar -->
                            <div class="flex items-center space-x-6">
                                <!-- Upvote Button -->
                                <form method="post" asp-page-handler="Vote" asp-route-interactionType="0" asp-route-postId="@post.PostId">
                                    <button type="submit" class="flex items-center text-gray-500 hover:text-green-600 dark:hover:text-green-400">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                                        </svg>
                                        <span class="ml-1">@(post.Upvote ?? 0)</span>
                                    </button>
                                </form>

                                <!-- Downvote Button -->
                                <form method="post" asp-page-handler="Vote" asp-route-interactionType="1" asp-route-postId="@post.PostId">
                                    <button type="submit" class="flex items-center text-gray-500 hover:text-red-600 dark:hover:text-red-400">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                        </svg>
                                        <span class="ml-1">@(post.Downvote ?? 0)</span>
                                    </button>
                                </form>

                                <!-- Comment Count -->
                                <span class="flex items-center text-gray-500 dark:text-gray-400">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M21 16v-5a2 2 0 00-2-2h-4.586a1 1 0 01-.707-.293l-1.414-1.414a2 2 0 00-1.414-.586H7a2 2 0 00-2 2v10a2 2 0 002 2h11a2 2 0 002-2z" /></svg>
                                    <span class="ml-1">@(post.Comment ?? 0)</span>
                                </span>
                            </div>
                    </article>
                </div>
            }
        </div>

        <!-- Right Column (Community Info) -->
        <div class="w-full lg:w-1/4 bg-dark p-4 rounded-lg shadow">
            <h3 class="text-lg font-semibold">About Community</h3>
            <p class="text-gray-600 mt-2">@Model.Community.Description</p>
            <div class="mt-4">
                <p><strong>@Model.Community.CreatedAt.ToString("MMMM yyyy")</strong></p>
                <p class="text-gray-600">Founded by <strong>@Model.Community.CreatorName</strong></p>
            </div>
        </div>
    </div>
</div>