@page "{id:int}"
@using System.Security.Claims
@model DetailsModel
@{
}

<div class="post-details mt-5">
    <main class="pt-6 pb-12 lg:pt-12 lg:pb-24 bg-transparent dark:bg-gray-900 antialiased">
        <div class="flex justify-between px-4 mt-2 mb-2 mx-auto max-w-screen-xl">
            <article class="mx-auto w-full max-w-2xl mt-2 mb-2 format format-sm sm:format-base lg:format-lg format-blue dark:format-invert">
                <!-- Header/Author information -->
                <div class="not-format">
                    <address class="flex items-center not-italic">
                        <div class="inline-flex items-center mr-3 text-sm text-gray-900 dark:text-white">
                            <img class="mr-2 w-8 h-8 rounded" src="https://isobarscience-1bfd8.kxcdn.com/wp-content/uploads/2020/09/default-profile-picture1.jpg" alt="@Model.PostDto.AuthorName">
                            <div>
                                <a class="text-sm font-medium text-gray-500 dark:text-gray-400">@(Model.PostDto.CommunityId.HasValue ? ("c/" + Model.PostDto.CommunityName) : ("p/" + Model.PostDto.AuthorName))</a>
                                @* Tính toán thời gian đã đăng *@
                                @{
                                    var vietnamTimeZone = TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");
                                    var createdTimeInVietnam = TimeZoneInfo.ConvertTimeFromUtc(Model.PostDto.CreatedAt, vietnamTimeZone);
                                    var elapsedTime = DateTimeOffset.Now - createdTimeInVietnam;

                                    string timeAgo;

                                    if (elapsedTime.TotalMinutes < 60)
                                    {
                                        timeAgo = $"{Math.Floor(elapsedTime.TotalMinutes)} minute(s) ago";
                                    }
                                    else if (elapsedTime.TotalHours < 24)
                                    {
                                        timeAgo = $"{Math.Floor(elapsedTime.TotalHours)} hr. ago";
                                    }
                                    else
                                    {
                                        timeAgo = $"{Math.Floor(elapsedTime.TotalDays)} day(s) ago";
                                    }
                                }
                                <span class="text-base text-gray-500 dark:text-gray-400"> • @timeAgo</span>
                            </div>
                        </div>
                    </address>
                    <h1 class="text-xl font-light leading-tight text-gray-900 lg:mb-1 lg:text-xl dark:text-white">@Model.PostDto.Title</h1>

                    <!-- Body content -->
                    <p class="body mb-1">
                        @Model.PostDto.Content @Model.PostDto.Content @Model.PostDto.Content @Model.PostDto.Content @Model.PostDto.Content
                    </p>

                    <!-- Interaction bar -->
                    <div class="flex items-center space-x-6">
                        <!-- Upvote Button -->
                        <button class="flex items-center text-gray-500 hover:text-green-600 dark:hover:text-green-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg>
                            <span class="ml-1">@(Model.PostDto.Upvote ?? 0)</span>
                        </button>

                        <!-- Downvote Button -->
                        <button class="flex items-center text-gray-500 hover:text-red-600 dark:hover:text-red-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            <span class="ml-1">@(Model.PostDto.Downvote ?? 0)</span>
                        </button>

                        <!-- Comment Count -->
                        <span class="flex items-center text-gray-500 dark:text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M21 16v-5a2 2 0 00-2-2h-4.586a1 1 0 01-.707-.293l-1.414-1.414a2 2 0 00-1.414-.586H7a2 2 0 00-2 2v10a2 2 0 002 2h11a2 2 0 002-2z" /></svg>
                            <span class="ml-1">@(Model.PostDto.Comment ?? 0)</span>
                        </span>
                    </div>
                </div>

                <!-- Comment -->
                <section class="not-format mt-6">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-lg lg:text-2xl font-bold text-gray-900 dark:text-white">Comments (@Model.PostDto.Comment)</h2>
                    </div>

                    <!-- Create a comment -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        <form class="mb-6" method="post" asp-page-handler="CreateComment">
                            <input asp-for="@Model.CreateCommentDto.PostId" type="number" value="@Model.PostDto.PostId" hidden />
                            <input asp-for="@Model.CreateCommentDto.UserId" type="number" value="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value" hidden />
                            <input asp-for="@Model.CreateCommentDto.UserName" type="text" value="@User.FindFirst(ClaimTypes.Name)?.Value" hidden />
                            <div class="py-2 px-4 mb-4 bg-transparent rounded-lg rounded-t-lg border border-gray-200 dark:bg-gray-800 dark:border-gray-700">
                                <label for="comment" class="sr-only">Your comment</label>
                                <textarea id="comment" type="text" rows="6" asp-for="@Model.CreateCommentDto.Content"
                                          class="px-0 w-full bg-transparent text-sm text-gray-900 border-0 focus:ring-0 dark:text-white dark:placeholder-gray-400 dark:bg-gray-800"
                                          placeholder="Write a comment..." required></textarea>
                            </div>
                            <button type="submit"
                                    class="inline-flex items-center py-2.5 px-4 text-xs font-medium text-center text-white bg-primary rounded-lg focus:ring-4 focus:ring-primary-200 dark:focus:ring-primary-900 hover:bg-primary-800">
                                Submit comment
                            </button>
                        </form>
@*                         <form class="mb-6" method="post" asp-page-handler="CreateComment">
                            <input name="postId" value="@Model.PostDto.PostId" disabled hidden />
                            <input name="userId" value="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value" disabled hidden />
                            <input name="userName" value="@User.FindFirst(ClaimTypes.Name)?.Value" disabled hidden />
                            <div class="py-2 px-4 mb-4 bg-transparent rounded-lg rounded-t-lg border border-gray-200 dark:bg-gray-800 dark:border-gray-700">
                                <label for="comment" class="sr-only">Your comment</label>
                                <textarea id="comment" rows="6"
                                          class="px-0 w-full bg-transparent text-sm text-gray-900 border-0 focus:ring-0 dark:text-white dark:placeholder-gray-400 dark:bg-gray-800"
                                          placeholder="Write a comment..." required></textarea>
                            </div>
                            <button type="submit"
                                    class="inline-flex items-center py-2.5 px-4 text-xs font-medium text-center text-white bg-primary rounded-lg focus:ring-4 focus:ring-primary-200 dark:focus:ring-primary-900 hover:bg-primary-800">
                                Submit comment
                            </button>
                        </form> *@
                    }
                    else
                    {
                        <p class="body mb-1">Login to comment on this post</p>
                    }

                    <!-- Comment List -->
                    @foreach (var comment in Model.CommentDtos)
                    {
                        <article class="p-6 mb-6 text-base bg-transparent rounded-lg dark:bg-gray-900">
                            <footer class="flex justify-between items-center mb-2">
                                <div class="flex items-center">
                                    <p class="inline-flex items-center mr-3 font-semibold text-sm text-gray-900 dark:text-white">
                                        <img class="mr-2 w-6 h-6 rounded"
                                             src="https://isobarscience-1bfd8.kxcdn.com/wp-content/uploads/2020/09/default-profile-picture1.jpg"
                                             alt="Michael Gough">@(comment.UserName ?? "Unknown")
                                    </p>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">
                                        <time>@comment.CreatedAt.AddHours(7)</time>
                                    </p>
                                </div>
                                <button id="dropdownComment1Button" data-dropdown-toggle="dropdownComment1"
                                        class="inline-flex items-center p-2 text-sm font-medium text-center text-gray-500 bg-transparent rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-50 dark:text-gray-400 dark:bg-gray-900 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
                                        type="button">
                                    <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 3">
                                        <path d="M2 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm6.041 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM14 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Z" />
                                    </svg>
                                    <span class="sr-only">Comment settings</span>
                                </button>
                                <!-- Dropdown menu -->
                                <div id="dropdownComment1"
                                     class="hidden z-10 w-36 bg-transparent rounded divide-y divide-gray-100 shadow dark:bg-gray-700 dark:divide-gray-600">
                                    <ul class="py-1 text-sm text-gray-700 dark:text-gray-200"
                                        aria-labelledby="dropdownMenuIconHorizontalButton">
                                        <li>
                                            <a href="#"
                                               class="block py-2 px-4 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Edit</a>
                                        </li>
                                        <li>
                                            <a href="#"
                                               class="block py-2 px-4 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Remove</a>
                                        </li>
                                        <li>
                                            <a href="#"
                                               class="block py-2 px-4 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Report</a>
                                        </li>
                                    </ul>
                                </div>
                            </footer>
                            <p>@comment.Content</p>
                            <div class="flex items-center mt-4 space-x-4">
                                <button type="button"
                                        class="flex items-center font-medium text-sm text-gray-500 hover:underline dark:text-gray-400">
                                    <svg class="mr-1.5 w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 18">
                                        <path d="M18 0H2a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h2v4a1 1 0 0 0 1.707.707L10.414 13H18a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2Zm-5 4h2a1 1 0 1 1 0 2h-2a1 1 0 1 1 0-2ZM5 4h5a1 1 0 1 1 0 2H5a1 1 0 0 1 0-2Zm2 5H5a1 1 0 0 1 0-2h2a1 1 0 0 1 0 2Zm9 0h-6a1 1 0 0 1 0-2h6a1 1 0 1 1 0 2Z" />
                                    </svg>
                                    Reply
                                </button>
                            </div>
                        </article>
                    }
                </section>
            </article>
        </div>
    </main>
</div>
